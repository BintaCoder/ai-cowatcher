    {
      "title": "QA cache hit rate",
      "description": "Primary cache-health signal. hit_rate = hits / (hits+misses). Split by exact|semantic hit counters available below.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "expr": "sum(rate(cowatcher_qa_cache_hit_total[5m])) / clamp_min(sum(rate(cowatcher_qa_cache_hit_total[5m])) + sum(rate(cowatcher_qa_cache_miss_total[5m])), 1e-9)",
          "legendFormat": "hit_rate"
        },
        {
          "expr": "sum(rate(cowatcher_qa_cache_hit_total{source=\"exact\"}[5m])) / clamp_min(sum(rate(cowatcher_qa_cache_hit_total[5m])) + sum(rate(cowatcher_qa_cache_miss_total[5m])), 1e-9)",
          "legendFormat": "exact_share"
        },
        {
          "expr": "sum(rate(cowatcher_qa_cache_hit_total{source=\"semantic\"}[5m])) / clamp_min(sum(rate(cowatcher_qa_cache_hit_total[5m])) + sum(rate(cowatcher_qa_cache_miss_total[5m])), 1e-9)",
          "legendFormat": "semantic_share"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line"
          }
        }
      }
    },
    {
      "title": "QA cache hits vs misses",
      "description": "cowatcher_qa_cache_hit_total{source=exact|semantic} vs cowatcher_qa_cache_miss_total",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "targets": [
        {
          "expr": "sum(rate(cowatcher_qa_cache_hit_total[5m])) by (source)",
          "legendFormat": "hit:{{source}}"
        },
        {
          "expr": "sum(rate(cowatcher_qa_cache_miss_total[5m]))",
          "legendFormat": "miss"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line"
          }
        }
      }
    }
  ],
