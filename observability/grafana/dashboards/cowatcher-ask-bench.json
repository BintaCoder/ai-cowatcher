    {
      "title": "Latest run \u2014 compare by Persona / Gender",
      "description": "All rows for the most recent run_id, sorted by persona then question so you can compare tone across companions.",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "cowatcher-postgres"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "cowatcher-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  COALESCE(NULLIF(TRIM(persona_id), ''), '(default)') AS \"Persona\",\n  COALESCE(NULLIF(TRIM(companion_gender), ''), '(unset)') AS \"Gender\",\n  question_id AS \"QID\",\n  question AS \"Question\",\n  ROUND(current_ts::numeric, 1) AS \"Playhead s\",\n  answer AS \"Answer\",\n  cache_source AS \"Cache\",\n  ROUND(latency_ms::numeric, 0) AS \"Latency ms\",\n  model_name AS \"Model\"\nFROM bench_ask_result\nWHERE run_id = (\n  SELECT run_id FROM bench_ask_result ORDER BY created_at DESC LIMIT 1\n)\nORDER BY 1, 2, question_id;",
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "md"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
