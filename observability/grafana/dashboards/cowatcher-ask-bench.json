  "panels": [
    {
      "title": "Archive \u2014 all stored rows (no time filter)",
      "description": "Every row still in Postgres. If this is empty but make bench-status shows rows, fix the Postgres datasource in Grafana (Connections \u2192 Postgres \u2192 Test).",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "cowatcher-postgres"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "cowatcher-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT created_at AS \"Time\", run_id AS \"Run\", COALESCE(NULLIF(TRIM(persona_id), ''), '(default)') AS \"Persona\", question_id AS \"QID\", LEFT(question, 60) AS \"Question\", LEFT(answer, 120) AS \"Answer\", cache_source AS \"Cache\", ROUND(latency_ms::numeric, 0) AS \"ms\"\nFROM bench_ask_result\nORDER BY created_at DESC\nLIMIT 300;",
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "title": "Answer quality review (Persona \u00b7 Gender \u00b7 Q \u00b7 A)",
      "description": "Full answer text with companion persona and gender for tone/quality review. Filtered to last 30 days (Postgres keeps rows indefinitely). Empty Persona usually means older bench rows before persona columns were stored \u2014 re-run make bench-ask.",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "cowatcher-postgres"
      },
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "cowatcher-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  created_at AS \"Time\",\n  run_id AS \"Run\",\n  COALESCE(NULLIF(TRIM(persona_id), ''), '(default)') AS \"Persona\",\n  COALESCE(NULLIF(TRIM(companion_gender), ''), '(unset)') AS \"Gender\",\n  question_id AS \"QID\",\n  question AS \"Question\",\n  ROUND(current_ts::numeric, 1) AS \"Playhead s\",\n  answer AS \"Answer\",\n  cache_source AS \"Cache\",\n  ROUND(latency_ms::numeric, 0) AS \"Latency ms\",\n  status AS \"Status\"\nFROM bench_ask_result\nWHERE $__timeFilter(created_at)\nORDER BY created_at DESC\nLIMIT 500;",
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "footer": {
          "show": false
        }
      },
