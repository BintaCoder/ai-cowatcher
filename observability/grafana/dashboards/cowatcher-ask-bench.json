              "options": "Answer"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 500
              }
            ]
          }
        ]
      }
    },
    {
      "title": "Run history (last 30d)",
      "description": "Every bench run_id still in Postgres. Use this when Latest run alone hides older sessions. JSONL under benchmarks/results/ can reimport missing rows via make bench-reimport.",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "cowatcher-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 38
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "cowatcher-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  run_id AS \"Run\",\n  MIN(created_at) AS \"Started\",\n  COUNT(*) AS n,\n  COUNT(DISTINCT persona_id) AS personas,\n  ROUND(AVG(latency_ms) FILTER (WHERE status = 'ok' AND latency_ms >= 0)::numeric, 0) AS avg_ms,\n  COUNT(*) FILTER (WHERE cache_source = 'miss') AS misses,\n  COUNT(*) FILTER (WHERE cache_source IN ('exact','semantic')) AS cache_hits\nFROM bench_ask_result\nWHERE $__timeFilter(created_at)\nGROUP BY run_id\nORDER BY MIN(created_at) DESC;",
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "title": "Rows by Persona \u00d7 Gender (last 30d)",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "cowatcher-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 46
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "cowatcher-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  COALESCE(NULLIF(TRIM(persona_id), ''), '(default)') AS \"Persona\",\n  COALESCE(NULLIF(TRIM(companion_gender), ''), '(unset)') AS \"Gender\",\n  COUNT(*) AS n,\n  ROUND(AVG(latency_ms) FILTER (WHERE status = 'ok' AND latency_ms >= 0)::numeric, 0) AS avg_ms\nFROM bench_ask_result\nWHERE $__timeFilter(created_at)\nGROUP BY 1, 2\nORDER BY 1, 2;",
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "title": "Latency by Cache (last 30d)",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "cowatcher-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 46
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "cowatcher-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  cache_source AS \"Cache\",\n  COUNT(*) AS n,\n  ROUND(AVG(latency_ms)::numeric, 0) AS avg_ms,\n  ROUND(PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY latency_ms)::numeric, 0) AS p50_ms,\n  ROUND(PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY latency_ms)::numeric, 0) AS p95_ms\nFROM bench_ask_result\nWHERE $__timeFilter(created_at)\n  AND status = 'ok'\n  AND latency_ms >= 0\nGROUP BY cache_source\nORDER BY cache_source;",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Cache mix (last 30d)",
      "type": "piechart",
      "datasource": {
        "type": "postgres",
        "uid": "cowatcher-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 46
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "cowatcher-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT cache_source AS metric, COUNT(*) AS value\nFROM bench_ask_result\nWHERE $__timeFilter(created_at)\nGROUP BY cache_source;",
          "refId": "A"
        }
      ]
    },
    {
      "title": "/ask p95 latency (API, Prom)",
